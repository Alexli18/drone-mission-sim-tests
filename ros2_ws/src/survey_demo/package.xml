<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>survey_demo</name>
  <version>0.1.0</version>
  <description>Toy survey sensor, marker detector, ready gate, bag player and launch files for the line-survey test.</description>
  <maintainer email="alexligay1807@gmail.com">Alexli18</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>sensor_bridge</exec_depend>
  <exec_depend>sensor_bridge_msgs</exec_depend>
  <exec_depend>survey_demo_msgs</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
